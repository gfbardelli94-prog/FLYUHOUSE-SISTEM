{
  "version": 2,
  "name": "flyhouse",
  "rewrites": [
    { "source": "/s/:token", "destination": "/api/share?pres=:token" },
    { "source": "/og/:token", "destination": "/api/og?pres=:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
